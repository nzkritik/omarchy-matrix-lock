#!/bin/bash

# Draws the matrix rain on the Omarchy lock screen.
#
# The lock screen is a WlSessionLock surface owned by the built-in omarchy.lock
# plugin. A session lock covers every layer-shell surface on the output, so a
# desktop wallpaper overlay cannot show through it -- the rain has to be drawn
# inside the lock's own QML. Omarchy's supported route for that is
# `omarchy plugin clone`, which copies omarchy.lock to <user>.lock and switches
# the shell over to the copy.
#
# LockView.qml and Service.qml are regenerated from the *installed* stock files
# on every run, so an install picks up whatever Omarchy currently ships rather
# than freezing a copy taken when this script was written. Service.qml only
# gains the two timings below; its password and fingerprint PAM flow is left
# exactly as shipped.
#
#   install      clone omarchy.lock if needed, then draw the rain on it
#   uninstall    put the stock lock screen back
#   sync         regenerate the clone against the lock screen you have now,
#                and apply the current settings
#   set <setting> <time>
#                change a setting in shell.json and apply it. <time> is
#                seconds, or 30s / 2m / 1h, or "off"
#                  hide-fields  hide the password field after this long idle,
#                               leaving only the rain (default off)
#                  display-off  turn the display off after this long idle
#                               (default 5s, as stock Omarchy)
#   status       report what is installed and the settings in effect
#   check        exit 0 if the clone is current, 3 if an update left it stale
#   notice       used by the plugin: exit 0 once, the first time it finds the
#                lock screen not set up, so it can say how; 1 otherwise
#
# Requires: omarchy 4+ (a Quickshell lock screen; there is no hyprlock).

set -euo pipefail

# Every tool this uses is part of Omarchy or the base system, so resolve them
# from those two root-owned directories only, never from an inherited PATH. The
# output of this script becomes the lock screen.
PATH=/usr/share/omarchy/bin:/usr/bin
export PATH

SELF=$(readlink -f "$0")
PLUGIN_DIR=${SELF%/bin/*}
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
SHELL_JSON="$HOME/.config/omarchy/shell.json"

# Fixed, root-owned installation root. Deliberately NOT $OMARCHY_PATH: this
# names the files whose contents become the user's lock screen, so it must not
# be redirectable by the environment of whoever invokes the script.
STOCK_ROOT="/usr/share/omarchy"
STOCK_DIR="$STOCK_ROOT/shell/plugins/lock"
STOCK_LOCKVIEW="$STOCK_DIR/LockView.qml"
STOCK_SERVICE="$STOCK_DIR/Service.qml"

SOURCE_ID="omarchy.lock"
PLUGIN_ID="nzkritik.matrix-lock"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-matrix-lock"

# Written into the generated files so a later run can tell its own output from
# a file the user has since edited by hand.
MARKER="nzkritik.matrix-lock:lock"
SERVICE_MARKER="nzkritik.matrix-lock:service"

# Recognised as ours as well: clones generated while this feature still lived in
# the nzkritik.matrix-rain plugin. The output was identical bar the marker
# string, so an existing install migrates on the next sync rather than being
# refused as somebody else's file.
MARKER_RE='nzkritik\.(matrix-lock|matrix-rain):lock'

# Everything the rain needs, copied verbatim into the clone. MatrixRain.qml is
# the entry the patched LockView loads; it picks the GPU renderer and falls back
# to the CPU one, so all of them travel together.
RAIN_FILES=(MatrixRain.qml MatrixRainGpu.qml MatrixRainCpu.qml rain.frag.qsb)

# Settings, in seconds; 0 turns the behaviour off. The defaults reproduce the
# stock lock screen: the field never hides and the display blanks after 5s.
DEFAULT_HIDE_FIELDS=0
DEFAULT_DISPLAY_OFF=5
MAX_SECONDS=86400

fail() {
  echo "omarchy-matrix-lock: $*" >&2
  exit 1
}

usage() {
  sed -n '3,34p' "$SELF" | sed 's|^# \?||'
}

# --- untrusted-path discipline -----------------------------------------------
#
# Everything under $HOME here is a predictable path writable by anything running
# as this user, so whatever is sitting at one is untrusted input -- and the
# output of this script becomes a lock screen, so the bar is higher than usual.

# iflag=nofollow refuses a symlink rather than following it somewhere else,
# nonblock means a planted FIFO returns immediately instead of wedging this
# process, and count bounds how much a swollen replacement can hand back.
read_guarded() { # <path> <block-size> <blocks>
  dd if="$1" iflag=nofollow,nonblock bs="$2" count="$3" 2>/dev/null || true
}

# A directory we are about to write into must be a real directory, reached
# without traversing a symlink at the final component.
require_real_dir() {
  [[ -L $1 ]] && fail "refusing to use $1: it is a symlink"
  [[ -d $1 ]] || fail "not a directory: $1"
  return 0
}

# A file we are about to replace must be absent, or a plain regular file that
# is not a symlink. A FIFO, device or link at the target would otherwise
# redirect or block the write.
require_plain_target() {
  [[ -L $1 ]] && fail "refusing to write $1: it is a symlink"
  [[ -e $1 && ! -f $1 ]] && fail "refusing to write $1: not a regular file"
  return 0
}

# Stage a temp file beside the destination -- same directory, so the commit is
# a rename within one filesystem and cannot fall back to a copy.
stage_tmp() { # <dest> -> prints tmp path
  local dir tmp
  dir=${1%/*}
  require_real_dir "$dir"
  require_plain_target "$1"
  tmp=$(mktemp "$dir/.omarchy-matrix-lock.XXXXXX") || fail "could not stage a write in $dir"
  chmod 0644 "$tmp"
  printf '%s' "$tmp"
}

# Flush, recheck the target, then rename. The recheck narrows the window in
# which the destination could be swapped for a link between staging and commit;
# bash cannot hold a directory descriptor across the rename, so this is a bound
# on the race rather than the elimination of it. The rename itself does not
# follow a symlink at the destination, so the worst case is a refusal.
commit_tmp() { # <tmp> <dest>
  sync "$1" 2>/dev/null || sync
  require_plain_target "$2"
  mv -f "$1" "$2" || { rm -f "$1"; fail "could not install $2"; }
}

discard_tmp() { rm -f "$1" 2>/dev/null || true; }

# --- clone identity ----------------------------------------------------------

# From the password database, not $USER: the environment is mutable by the
# caller and this becomes a directory name under ~/.config/omarchy/plugins.
CLONE_USER=$(id -un)
[[ $CLONE_USER =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] ||
  fail "refusing implausible user name for the clone id: $CLONE_USER"
CLONE_ID="$CLONE_USER.lock"
CLONE_DIR="$PLUGINS_DIR/$CLONE_ID"

# --- settings ----------------------------------------------------------------
#
# Kept on this plugin's entry in shell.json, beside every other shell setting:
#
#   "plugins": [ { "id": "nzkritik.matrix-lock",
#                  "hideFieldsAfter": 5, "displayOffAfter": 3600 } ]
#
# Omarchy hands a service plugin none of its shell.json entry, and the lock
# should not be reading user files while it runs anyway, so the values are
# written into the generated Service.qml by install/sync/set instead.

# Dotfile managers (stow and friends) commonly make shell.json a symlink, and
# the shell follows it, so this does too -- once, to a final path that must be
# a regular file. Every read and write after that refuses links as usual. The
# worst a planted link can do is point the two settings at another of the
# user's own files, which yields defaults.
shell_json_path() {
  local p=$SHELL_JSON
  [[ -L $p ]] && p=$(readlink -f "$p")
  [[ -n $p && -f $p && ! -L $p ]] || return 1
  printf '%s' "$p"
}

# 4MB is far beyond any real shell.json; the bound only stops a swollen file.
read_shell_json() {
  local p
  if ! p=$(shell_json_path); then
    [[ -e $SHELL_JSON || -L $SHELL_JSON ]] &&
      echo "omarchy-matrix-lock: $SHELL_JSON is not a regular file; using the default settings" >&2
    return 0
  fi
  read_guarded "$p" 4096 1024
}

# Prints "<hideFieldsAfter> <displayOffAfter>". A missing file, entry or key,
# or anything that is not a whole number of seconds in range, reads as the
# default: the lock screen must still generate from a broken shell.json.
SETTINGS_PY=$(cat <<'PYEOF'
import json, os, sys

defaults = {"hideFieldsAfter": int(os.environ["DEFAULT_HIDE_FIELDS"]),
            "displayOffAfter": int(os.environ["DEFAULT_DISPLAY_OFF"])}
limit = int(os.environ["MAX_SECONDS"])
entry = {}
try:
    cfg = json.loads(sys.stdin.read())
    for p in cfg.get("plugins", []) if isinstance(cfg, dict) else []:
        if isinstance(p, dict) and p.get("id") == os.environ["PLUGIN_ID"]:
            entry = p
            break
except ValueError:
    pass

out = []
for key, default in defaults.items():
    v = entry.get(key, default)
    if isinstance(v, bool) or not isinstance(v, int) or not 0 <= v <= limit:
        print("omarchy-matrix-lock: ignoring %s=%r in shell.json; using %d"
              % (key, v, default), file=sys.stderr)
        v = default
    out.append(str(v))
print(" ".join(out))
PYEOF
)

read_settings() {
  read_shell_json |
    DEFAULT_HIDE_FIELDS=$DEFAULT_HIDE_FIELDS DEFAULT_DISPLAY_OFF=$DEFAULT_DISPLAY_OFF \
      MAX_SECONDS=$MAX_SECONDS PLUGIN_ID=$PLUGIN_ID python3 -c "$SETTINGS_PY"
}

# "5", "30s", "2m", "1h" or "off" -> whole seconds.
parse_duration() {
  local v=${1,,} n
  [[ $v == off || $v == never ]] && { echo 0; return; }
  [[ $v =~ ^([0-9]{1,6})([smh]?)$ ]] || fail "not a duration: $1 (try 5, 30s, 2m, 1h or off)"
  n=$((10#${BASH_REMATCH[1]}))
  case ${BASH_REMATCH[2]} in
  m) n=$((n * 60)) ;;
  h) n=$((n * 3600)) ;;
  esac
  ((n <= MAX_SECONDS)) || fail "$1 is longer than 24h"
  echo "$n"
}

describe_seconds() {
  local s=$1
  if ((s == 0)); then echo "off"
  elif ((s % 3600 == 0)); then echo "$((s / 3600))h"
  elif ((s % 60 == 0)); then echo "$((s / 60))m"
  else echo "${s}s"
  fi
}

# Rewrites shell.json with one key changed on this plugin's entry, adding the
# entry if there is none. Same formatting as the shell's own writes
# (JSON.stringify with two-space indent), so the diff is only the change.
SET_PY=$(cat <<'PYEOF'
import json, os, sys

src = sys.stdin.read()
cfg = json.loads(src) if src.strip() else {}
if not isinstance(cfg, dict):
    sys.exit("shell.json is not a JSON object")
plugins = cfg.setdefault("plugins", [])
if not isinstance(plugins, list):
    sys.exit("shell.json 'plugins' is not a list")
pid = os.environ["PLUGIN_ID"]
for p in plugins:
    if isinstance(p, dict) and p.get("id") == pid:
        entry = p
        break
else:
    entry = {"id": pid}
    plugins.append(entry)
entry[os.environ["KEY"]] = int(os.environ["VALUE"])
sys.stdout.write(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
PYEOF
)

write_setting() { # <key> <seconds>
  local dest tmp
  if [[ -e $SHELL_JSON || -L $SHELL_JSON ]]; then
    dest=$(shell_json_path) || fail "refusing to write $SHELL_JSON: it is not a regular file"
  else
    dest=$SHELL_JSON
  fi
  tmp=$(stage_tmp "$dest")
  if ! read_shell_json | KEY="$1" VALUE="$2" PLUGIN_ID="$PLUGIN_ID" python3 -c "$SET_PY" >"$tmp"; then
    discard_tmp "$tmp"
    fail "could not update $dest; is it valid JSON?"
  fi
  commit_tmp "$tmp" "$dest"
}

# --- the patches -------------------------------------------------------------

# Both are applied to a stock file on stdin. Every anchor must match exactly
# once: if Omarchy reworks the lock screen the edit is refused outright rather
# than half-applied to it.
PATCH_COMMON_PY=$(cat <<'PYEOF'
import os, sys

s = sys.stdin.read()
if not s.strip():
    sys.exit("stock file was empty or unreadable")


def sub(old, new):
    global s
    if s.count(old) != 1:
        sys.exit("anchor matched %d times, expected 1:\n%s"
                 % (s.count(old), old.strip()[:120]))
    s = s.replace(old, new)
PYEOF
)

LOCKVIEW_PY=$(cat <<'PYEOF'
marker = os.environ["MARKER"]

sub(
    "  property bool loadBackground: true\n",
    "  property bool loadBackground: true\n"
    "  // Generated by " + marker + " -- edits here are overwritten on sync.\n"
    "  //\n"
    "  // The rain replaces the blurred wallpaper on every lock screen, whatever\n"
    "  // the desktop background is.\n"
    "  readonly property bool rainActive: true\n"
    "  // Raised by the service once the lock has sat untouched for the configured\n"
    "  // time: the password field fades out and only the rain is left. The first\n"
    "  // key press brings it back and is not typed into the field.\n"
    "  property bool fieldsHidden: false\n",
)

# Nothing decodes or blurs the wallpaper while the rain covers it.
sub(
    '      source: root.loadBackground ? root.fileUrl(root.backgroundPath) : ""',
    '      source: root.loadBackground && !root.rainActive ? root.fileUrl(root.backgroundPath) : ""',
)
sub(
    "      blurEnabled: root.loadBackground && wallpaper.status === Image.Ready",
    "      visible: !root.rainActive\n"
    "      blurEnabled: root.loadBackground && !root.rainActive && wallpaper.status === Image.Ready",
)

# Above the wallpaper, below the click-to-wake area and the password field.
mouse = "    MouseArea {\n      anchors.fill: parent\n      hoverEnabled: true\n"
sub(
    mouse,
    "    Loader {\n"
    "      id: rainLoader\n"
    "      anchors.fill: parent\n"
    "      active: root.rainActive\n"
    '      source: "MatrixRain.qml"\n'
    "    }\n"
    "\n"
    "    // loadBackground is the lock's own \"is anyone looking at this\" flag --\n"
    "    // root.locked when locked, previewVisible in the preview -- so the rain\n"
    "    // stops the moment the lock or the preview goes away.\n"
    "    Binding {\n"
    "      target: rainLoader.item\n"
    '      property: "playing"\n'
    "      value: root.loadBackground\n"
    "      when: rainLoader.item !== null\n"
    "      restoreMode: Binding.RestoreNone\n"
    "    }\n"
    "\n"
    + mouse,
)

# Faded rather than made invisible: an invisible TextInput loses keyboard focus,
# and the key that brings the field back has to land somewhere.
sub(
    "      id: inputField\n",
    "      id: inputField\n"
    "      opacity: root.fieldsHidden ? 0 : 1\n"
    "      Behavior on opacity { NumberAnimation { duration: 400 } }\n",
)

# Keys handlers run before the TextInput sees the key, so accepting it here
# keeps the waking key press out of the password.
sub(
    "        Keys.onPressed: function(event) {\n"
    "          root.wakeRequested()\n",
    "        Keys.onPressed: function(event) {\n"
    "          if (root.fieldsHidden) {\n"
    "            root.wakeRequested()\n"
    "            event.accepted = true\n"
    "            return\n"
    "          }\n"
    "          root.wakeRequested()\n",
)

sys.stdout.write(s)
PYEOF
)

SERVICE_PY=$(cat <<'PYEOF'
marker = os.environ["SERVICE_MARKER"]
hide = int(os.environ["HIDE_FIELDS"])
off = int(os.environ["DISPLAY_OFF"])

sub(
    "  readonly property bool authenticating: authenticatingPassword || fingerprintAuthenticating\n",
    "  readonly property bool authenticating: authenticatingPassword || fingerprintAuthenticating\n"
    "\n"
    "  // Generated by " + marker + " -- edits here are overwritten on sync.\n"
    "  // settings: hideFieldsAfter=%d displayOffAfter=%d\n" % (hide, off)
    + "  //\n"
    "  // The only changes from the stock service are these two timings and the\n"
    "  // state they drive; the password and fingerprint PAM flow is untouched.\n"
    "  // Both count from the last input on the lock screen, and 0 turns either\n"
    "  // one off. Change them with: omarchy-matrix-lock set\n"
    "  readonly property int hideFieldsMs: %d\n" % (hide * 1000)
    + "  readonly property int displayOffMs: %d\n" % (off * 1000)
    + "  property bool fieldsHidden: false\n"
    "\n"
    "  function armFieldsTimer() {\n"
    "    fieldsHidden = false\n"
    "    if (hideFieldsMs > 0 && (lockRequested || previewVisible)) fieldsTimer.restart()\n"
    "    else fieldsTimer.stop()\n"
    "  }\n",
)

# Every path that restarts the blank countdown -- locking, any input, a failed
# password -- restarts the hide countdown with it.
sub(
    "  function armBlankTimer() {\n"
    "    idleBlankTimer.armedAt = Date.now()\n",
    "  function armBlankTimer() {\n"
    "    armFieldsTimer()\n"
    "    if (displayOffMs <= 0) {\n"
    "      idleBlankTimer.stop()\n"
    "      return\n"
    "    }\n"
    "    idleBlankTimer.armedAt = Date.now()\n",
)

# Unlocking leaves the field showing for next time.
sub(
    "  function runWake() {\n"
    "    if (!wakeProcess.running) wakeProcess.running = true\n",
    "  function runWake() {\n"
    "    if (!lockRequested) armFieldsTimer()\n"
    "    if (!wakeProcess.running) wakeProcess.running = true\n",
)

sub(
    "    id: idleBlankTimer\n"
    "    interval: 5000\n",
    "    id: idleBlankTimer\n"
    "    interval: root.displayOffMs > 0 ? root.displayOffMs : 5000\n",
)

sub(
    "  Timer {\n"
    "    id: sessionLockStabilizeTimer\n",
    "  Timer {\n"
    "    id: fieldsTimer\n"
    "    interval: Math.max(1, root.hideFieldsMs)\n"
    "    repeat: false\n"
    "    // Never while a password is being checked or has been part-typed.\n"
    "    onTriggered: {\n"
    "      if ((root.lockRequested || root.previewVisible) && !root.authenticatingPassword\n"
    "          && root.enteredPassword.length === 0) root.fieldsHidden = true\n"
    "    }\n"
    "  }\n"
    "\n"
    "  Timer {\n"
    "    id: sessionLockStabilizeTimer\n",
)

sub(
    "        onWakeRequested: root.runWake()\n",
    "        onWakeRequested: root.runWake()\n"
    "        fieldsHidden: root.fieldsHidden\n",
)

# The preview runs the hide countdown too, so the setting can be seen without
# locking the session.
sub(
    "      loadBackground: root.previewVisible\n",
    "      loadBackground: root.previewVisible\n"
    "      fieldsHidden: root.fieldsHidden\n",
)
sub(
    "      root.previewVisible = true\n",
    "      root.previewVisible = true\n"
    "      root.armFieldsTimer()\n",
)

sys.stdout.write(s)
PYEOF
)

# The stock files are read here rather than opened by the patcher, so the bound
# and the no-follow apply to them too. 1MB is ~20x either real file.
read_stock() { # <path>
  [[ -f $1 && ! -L $1 ]] || fail "stock lock file is missing or not a regular file: $1"
  read_guarded "$1" 4096 256
}

generate_lockview() {
  read_stock "$STOCK_LOCKVIEW" |
    MARKER="$MARKER" python3 -c "$PATCH_COMMON_PY"$'\n'"$LOCKVIEW_PY"
}

generate_service() { # <hide-seconds> <off-seconds>
  read_stock "$STOCK_SERVICE" |
    SERVICE_MARKER="$SERVICE_MARKER" HIDE_FIELDS="$1" DISPLAY_OFF="$2" \
      python3 -c "$PATCH_COMMON_PY"$'\n'"$SERVICE_PY"
}

# Identifies the stock lock screen this clone was generated from, so a later
# Omarchy update can be noticed.
stock_id() {
  { read_stock "$STOCK_LOCKVIEW"; read_stock "$STOCK_SERVICE"; } | sha256sum | cut -d' ' -f1
}

STAMP="$STATE_DIR/stock-lockview.sha256"

require_stock() {
  [[ -d $STOCK_DIR ]] || fail "stock lock plugin not found at $STOCK_DIR (needs Omarchy 4+)"
  [[ -f $STOCK_LOCKVIEW ]] || fail "stock lock view not found at $STOCK_LOCKVIEW (needs Omarchy 4+)"
  [[ -f $STOCK_SERVICE ]] || fail "stock lock service not found at $STOCK_SERVICE (needs Omarchy 4+)"
  local f
  for f in "${RAIN_FILES[@]}"; do
    [[ -f $PLUGIN_DIR/$f ]] || fail "$f missing from $PLUGIN_DIR"
  done
}

# True when the clone's LockView is ours, so regenerating it loses nothing.
clone_is_generated() {
  [[ -f $CLONE_DIR/LockView.qml && ! -L $CLONE_DIR/LockView.qml ]] || return 1
  read_guarded "$CLONE_DIR/LockView.qml" 4096 256 | grep -qE "$MARKER_RE"
}

# True when the clone's Service.qml is ours or still exactly as cloned -- a 1.2
# clone left it stock -- so regenerating it loses nothing either.
service_is_replaceable() {
  local f="$CLONE_DIR/Service.qml"
  [[ -e $f || -L $f ]] || return 0
  [[ -f $f && ! -L $f ]] || return 1
  read_guarded "$f" 4096 256 | grep -qF "$SERVICE_MARKER" && return 0
  cmp -s "$f" "$STOCK_SERVICE"
}

# The settings baked into the clone's Service.qml, as "<hide> <off>", or
# nothing when it has none.
applied_settings() {
  read_guarded "$CLONE_DIR/Service.qml" 4096 256 |
    sed -nE 's|^  // settings: hideFieldsAfter=([0-9]+) displayOffAfter=([0-9]+)$|\1 \2|p' | head -n1
}

write_file() { # <dest> -- content on stdin
  local tmp
  tmp=$(stage_tmp "$1")
  if ! cat >"$tmp"; then
    discard_tmp "$tmp"
    return 1
  fi
  commit_tmp "$tmp" "$1"
}

write_clone() {
  require_real_dir "$CLONE_DIR"

  local settings hide off
  settings=$(read_settings) || fail "could not read the settings from $SHELL_JSON"
  read -r hide off <<<"$settings"

  # Both are generated before either is written, so a stock file this plugin
  # cannot patch leaves the existing lock screen untouched rather than half
  # updated. Staged files, not $(...), which would eat the trailing newline.
  local view service
  view=$(stage_tmp "$CLONE_DIR/LockView.qml")
  service=$(stage_tmp "$CLONE_DIR/Service.qml")
  if ! generate_lockview >"$view" || ! generate_service "$hide" "$off" >"$service"; then
    discard_tmp "$view"
    discard_tmp "$service"
    fail "could not patch the lock screen -- this Omarchy's lock screen differs from what this plugin expects. Please report it at github.com/nzkritik/omarchy-matrix-lock."
  fi
  commit_tmp "$service" "$CLONE_DIR/Service.qml"
  commit_tmp "$view" "$CLONE_DIR/LockView.qml"

  local f
  for f in "${RAIN_FILES[@]}"; do
    write_file "$CLONE_DIR/$f" <"$PLUGIN_DIR/$f" || fail "could not copy $f into $CLONE_DIR"
  done

  write_stamp
}

write_stamp() {
  mkdir -p "$STATE_DIR"
  require_real_dir "$STATE_DIR"
  local tmp
  tmp=$(stage_tmp "$STAMP")
  if ! stock_id >"$tmp"; then
    discard_tmp "$tmp"
    fail "could not record the stock lock screen version"
  fi
  commit_tmp "$tmp" "$STAMP"
}

# 0 current, 3 stale, 1 not installed.
clone_state() {
  [[ -d $CLONE_DIR ]] || return 1
  clone_is_generated || return 1
  local recorded current
  recorded=$(read_guarded "$STAMP" 1 128 | head -n1)
  current=$(stock_id)
  [[ -n $recorded && $recorded == "$current" ]] || return 3
  # A clone made by an older version of this plugin lacks some of these, or
  # has a stock Service.qml, which reads as stale too -- and `sync` is exactly
  # what brings it up to date.
  read_guarded "$CLONE_DIR/Service.qml" 4096 256 | grep -qF "$SERVICE_MARKER" || return 3
  local f
  for f in "${RAIN_FILES[@]}"; do
    cmp -s "$CLONE_DIR/$f" "$PLUGIN_DIR/$f" || return 3
  done
  return 0
}

cmd_install() {
  require_stock

  if [[ ! -d $CLONE_DIR ]]; then
    omarchy-plugin-clone "$SOURCE_ID" >/dev/null ||
      fail "could not clone $SOURCE_ID"
    echo "Cloned $SOURCE_ID to $CLONE_ID"
  elif ! clone_is_generated && ! cmp -s "$CLONE_DIR/LockView.qml" "$STOCK_LOCKVIEW"; then
    fail "$CLONE_DIR/LockView.qml has your own edits; back them up and delete the file to continue"
  fi
  service_is_replaceable ||
    fail "$CLONE_DIR/Service.qml has your own edits; back them up and delete the file to continue"

  write_clone
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

  echo "Matrix rain installed on the lock screen ($CLONE_ID)."
  echo "Run 'omarchy restart shell' to load it, then preview with:"
  echo "  omarchy-shell lock preview"
}

sync_clone() {
  require_stock
  [[ -d $CLONE_DIR ]] || fail "not installed; run: omarchy-matrix-lock install"
  clone_is_generated ||
    fail "$CLONE_DIR/LockView.qml was not generated by this plugin; refusing to overwrite it"
  service_is_replaceable ||
    fail "$CLONE_DIR/Service.qml has your own edits; refusing to overwrite it"

  write_clone
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
}

cmd_sync() {
  sync_clone
  echo "Refreshed $CLONE_ID against the installed lock screen. Run 'omarchy restart shell'."
}

cmd_set() {
  local name=${1:-} value=${2:-} key seconds
  [[ -n $name && -n $value ]] || fail "usage: omarchy-matrix-lock set hide-fields|display-off <seconds|30s|2m|1h|off>"
  case $name in
  hide-fields) key=hideFieldsAfter ;;
  display-off) key=displayOffAfter ;;
  *) fail "unknown setting: $name (hide-fields or display-off)" ;;
  esac
  seconds=$(parse_duration "$value")

  write_setting "$key" "$seconds"
  echo "$name: $(describe_seconds "$seconds") (saved to shell.json)"

  local state=0
  clone_state || state=$?
  if ((state == 1)); then
    echo "The lock screen is not set up yet; it takes effect on: omarchy-matrix-lock install"
    return 0
  fi
  sync_clone
  echo "Run 'omarchy restart shell' to apply it."
}

cmd_uninstall() {
  [[ -d $CLONE_DIR ]] || { echo "Not installed; nothing to do."; return 0; }
  clone_is_generated ||
    fail "$CLONE_DIR was not set up by this plugin; remove it yourself with: omarchy plugin remove $CLONE_ID"

  # Anything beyond what the clone and this script create is the user's, so the
  # whole clone is only removed when nothing of theirs would go with it.
  local extra f
  local ours=(! -name LockView.qml ! -name Service.qml ! -name manifest.json)
  for f in "${RAIN_FILES[@]}"; do ours+=(! -name "$f"); done
  extra=$(find "$CLONE_DIR" -mindepth 1 -maxdepth 1 "${ours[@]}")

  if [[ -z $extra ]] && service_is_replaceable; then
    omarchy-plugin-remove "$CLONE_ID" --yes >/dev/null ||
      fail "could not remove $CLONE_ID"
    echo "Removed $CLONE_ID; the built-in lock screen is back."
  else
    require_real_dir "$CLONE_DIR"
    read_stock "$STOCK_LOCKVIEW" | write_file "$CLONE_DIR/LockView.qml" ||
      fail "could not restore the stock LockView.qml"
    if service_is_replaceable; then
      read_stock "$STOCK_SERVICE" | write_file "$CLONE_DIR/Service.qml" ||
        fail "could not restore the stock Service.qml"
    fi
    for f in "${RAIN_FILES[@]}"; do rm -f "$CLONE_DIR/$f"; done
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    echo "Reverted the rain from $CLONE_ID and kept your other changes to it."
  fi
  rm -f "$STAMP" 2>/dev/null || true
  echo "Run 'omarchy restart shell' to apply."
}

cmd_status() {
  local state=0
  clone_state || state=$?

  case $state in
  0) echo "lock rain:    installed on $CLONE_ID" ;;
  3) echo "lock rain:    installed on $CLONE_ID (stale -- run: omarchy-matrix-lock sync)" ;;
  *)
    if [[ ! -d $CLONE_DIR ]]; then
      echo "lock rain:    not installed"
    else
      echo "lock rain:    $CLONE_ID exists but was not set up by this plugin"
    fi
    ;;
  esac

  local hide off applied
  read -r hide off <<<"$(read_settings)"
  echo "hide-fields:  $(describe_seconds "$hide")"
  echo "display-off:  $(describe_seconds "$off")"
  if ((state != 1)); then
    applied=$(applied_settings)
    [[ $applied == "$hide $off" ]] ||
      echo "              (shell.json differs from the lock screen -- run: omarchy-matrix-lock sync)"
  fi
}

# Quiet, for the service to poll.
# Shown once: a plugin added through `omarchy plugin add` does nothing to the
# lock screen until `install` is run, and would otherwise say nothing about it.
# The marker is written like everything else here (staged, then renamed) and is
# kept by uninstall, so choosing not to set up is never nagged about.
cmd_notice() {
  local state=0 marker="$STATE_DIR/setup-hint-shown"
  clone_state || state=$?
  [[ $state == 1 ]] || exit 1
  [[ -e $marker || -L $marker ]] && exit 1
  mkdir -p "$STATE_DIR"
  require_real_dir "$STATE_DIR"
  local tmp
  tmp=$(stage_tmp "$marker")
  commit_tmp "$tmp" "$marker"
  exit 0
}

cmd_check() {
  local state=0
  clone_state || state=$?
  exit $state
}

case "${1:-}" in
install) cmd_install ;;
uninstall | remove) cmd_uninstall ;;
sync) cmd_sync ;;
set) shift; cmd_set "$@" ;;
status) cmd_status ;;
check) cmd_check ;;
notice) cmd_notice ;;
-h | --help | "") usage ;;
*) fail "unknown command: $1 (try --help)" ;;
esac
